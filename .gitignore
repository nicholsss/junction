.DS_Store

# Local environment and secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Local logs
*.log

# Local copy of Tieto sample repo (own clone, do not commit)
sample/

# Raw test logs from evidence/run-checks.sh (machine-specific paths)
evidence/*.log
evidence/*.summary
evidence/ALL_DONE

# Per-test result files (regenerate with evidence/run-trx.sh)
evidence/trx/

# Python runtime caches
__pycache__/
*.pyc
.venv/

node_modules/
